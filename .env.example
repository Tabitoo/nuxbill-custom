TZ=Africa/Nairobi
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=nuxbill
MYSQL_USER=nuxbill
MYSQL_PASSWORD=change_me

# Network/CIDR your Mikrotik router(s) will connect from, e.g. 192.168.88.0/24.
# 0.0.0.0/0 accepts any source IP - fine for local testing, tighten it for production.
RADIUS_CLIENT_NETWORK=0.0.0.0/0
# Shared secret configured on the Mikrotik's RADIUS client settings too.
RADIUS_SECRET=change_me
